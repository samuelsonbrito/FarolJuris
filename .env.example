APP_NAME="FarolJuris"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Cadastro pelo site (false = só o administrador cria contas: php artisan usuario:criar)
APP_CADASTRO_ABERTO=false

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=faroljuris
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alertas@faroljuris.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- DJEN / Comunica API (CNJ) ---------------------------------------------
# Produção: https://comunicaapi.pje.jus.br/api/v1
# Homologação: https://hcomunicaapi.cnj.jus.br/api/v1
# Atenção: a API bloqueia IPs fora do Brasil (CloudFront 403).
# Fonte das comunicações: api (Comunica API, via nosso backend; exige IP no Brasil)
# ou fake (45 comunicações fictícias, para desenvolver fora do Brasil ou offline).
DJEN_GATEWAY=api
DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1
DJEN_TIMEOUT=20
DJEN_CONNECT_TIMEOUT=5
DJEN_RETRY_TIMES=3
DJEN_RETRY_SLEEP_MS=500
DJEN_RETRY_MAX_SLEEP_MS=10000
DJEN_ITENS_POR_PAGINA=20
DJEN_USER_AGENT="FarolJuris/1.0"
DJEN_CACHE_TTL=600
DJEN_RATE_LIMIT_PER_MINUTE=15
DJEN_PUBLIC_RATE_LIMIT_PER_MINUTE=30
DJEN_MONITORING_TIME=07:00
DJEN_MONITORING_TIMEZONE=America/Manaus
DJEN_MONITORING_LOOKBACK_DAYS=3
DJEN_MONITORING_ITENS_POR_PAGINA=100
DJEN_MONITORING_MAX_PAGINAS=5
DJEN_MONITORING_MAX_ALVOS=50
DJEN_EXPORT_DISK=local
DJEN_EXPORT_LIMITE_SINCRONO=100
DJEN_EXPORT_MAX_ITENS=2000
DJEN_EXPORT_DIAS_RETENCAO=7
DJEN_RASTREIO_ATIVO=true
DJEN_RASTREIO_DIAS_RETENCAO=180
DJEN_WHATSAPP_DRIVER=log
