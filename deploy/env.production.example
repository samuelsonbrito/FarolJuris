# Diferenças do .env de produção em relação ao .env.example (sem segredos).
# Copie o .env.example para .env no servidor e ajuste estes valores.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://faroljuris.com.br
# Cadastro pelo site fechado: contas criadas com php artisan usuario:criar
APP_CADASTRO_ABERTO=false
LOG_LEVEL=warning
LOG_STACK=daily

DB_HOST=127.0.0.1
DB_DATABASE=faroljuris
DB_USERNAME=faroljuris
# DB_PASSWORD=  (defina no servidor)

REDIS_HOST=127.0.0.1
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Provedor de e-mail transacional (SMTP). Defina usuário/senha no servidor.
MAIL_MAILER=smtp
MAIL_HOST=smtp.seu-provedor.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="alertas@faroljuris.com.br"

# Dados reais (exige servidor com IP no Brasil).
DJEN_GATEWAY=api
DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1
